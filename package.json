{
  "name": "dsh-prompt-optimizer",
  "description": "Optimize the composer prompt with session context awareness, using the currently selected model",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "prompt",
    "prompt-optimizer",
    "composer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subisle/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/subisle/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/subisle/dsh-prompt-optimizer/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "test": "node test/check.mjs",
    "check": "node build.mjs && node test/check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": []
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "file:vendor/dsh-client-ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-alpha.2",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}